PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=dev-secret

# OTP settings
# Use "mock" for local/dev testing with a fixed OTP (default is 123456).
# Switch to "sms" when SMS gateway integration is added in src/services/otp.service.js.
OTP_MODE=mock
FAKE_OTP=123456

# Dummy payment gateway settings for /v1/payments/checkout
# Allowed status values: success, failed, in-progress
DUMMY_PAYMENT_GATEWAY_STATUS=success
DUMMY_PAYMENT_GATEWAY_LINK=https://dummy-pay.local/checkout
